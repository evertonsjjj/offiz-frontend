{
  "name": "offiz-web-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "node scripts/demo-interface.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:interface": "npm run build && node scripts/studio-interface.mjs && node scripts/admin-interface.mjs && node scripts/deliveries-interface.mjs && node scripts/confirmation-interface.mjs && node scripts/recovery-interface.mjs && node scripts/production-interface.mjs && node scripts/acervo-selector-interface.mjs && node scripts/conversa-layout-interface.mjs",
    "test:interface:acervo": "npm run build && node scripts/acervo-selector-interface.mjs",
    "test:interface:conversa": "npm run build && node scripts/conversa-layout-interface.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "docx": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "1.63.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
